# Production: persistent PostgreSQL. Never commit real credentials.
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST/DATABASE?sslmode=require
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
BOT_TOKEN=
CHAT_ID=
PUBLIC_BASE_URL=
TELEGRAM_WEBHOOK_SECRET=
# Private chat: empty is OK. Group: comma-separated authorized Telegram user IDs.
TELEGRAM_ADMIN_USER_IDS=
# Optional; only if Itemsatis sends the corresponding X-Webhook-Secret header.
ITEMSATIS_WEBHOOK_SECRET=
WEBHOOK_IP_WHITELIST=
ORDER_WORKERS=4
WEB_CONCURRENCY=1
BLOCKED_CHECK_INTERVAL_SECONDS=900
ACTIVE_CHECK_INTERVAL_SECONDS=1800
REQUIRE_LEGACY_IMPORT=true
SMM_API_URL=https://smmrush.com/api/v2
SMM_API_KEY=
MEDYABAYIM_API_URL=https://medyabayim.com/api/v2
MEDYABAYIM_API_KEY=
LIONFOLLOW_API_URL=https://lionfollow.com/api/v2
LIONFOLLOW_API_KEY=
MORETHANPANEL_API_URL=https://morethanpanel.com/api/v2
MORETHANPANEL_API_KEY=
OLDSMM_API_URL=
OLDSMM_API_KEY=
# PANEL4_NAME / PANEL4_API_URL / PANEL4_API_KEY through PANEL6_...
# Only the one-off migration script reads these credentials.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
